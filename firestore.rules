rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'Qf6BCLccnvfJv5JEjROoxYlwhSv1';
    }

    // Existing documents are preserved, but only the owner's account can use
    // the launcher cloud profile. The UID in the path must still match.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }

    // The owner's published recap stays readable without login. Old recap
    // documents for other accounts are not deleted, but are no longer public.
    match /public-dashboard/{uid} {
      allow read: if uid == 'Qf6BCLccnvfJv5JEjROoxYlwhSv1';
      allow create, update, delete: if isOwner() && request.auth.uid == uid;
    }

    // Legacy shared storage is closed; migration must use the UID-scoped path.
    match /gamevault/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
