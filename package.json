{
  "name": "prg-launcher",
  "version": "1.2.3",
  "description": "PRGLauncher — Game Launcher & Tracker",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron . --enable-logging",
    "dev": "electron . --enable-logging",
    "test": "node --test tests/*.test.cjs",
    "test:emulator": "set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080&& node --test tests/firestore-emulator.test.cjs",
    "release:check": "node scripts/release-gate.cjs",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --universal"
  },
  "build": {
    "appId": "com.prgtracker.launcher",
    "productName": "PRGLauncher",
    "artifactName": "PRGLauncher-Setup-${version}.${ext}",
    "executableName": "PRGLauncher",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon-256.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.entertainment",
      "artifactName": "PRGLauncher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PRGLauncher",
      "uninstallDisplayName": "PRGLauncher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "plushenka12",
      "repo": "PRGLauncher",
      "releaseType": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "firebase-tools": "^15.32.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^10.0.0"
  }
}
